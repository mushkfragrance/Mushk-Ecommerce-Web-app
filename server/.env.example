NODE_ENV=development
PORT=5000

# MongoDB — local or Atlas connection string
# Local: mongodb://127.0.0.1:27017/mushk_fragrance
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/mushk_fragrance?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mushk_fragrance

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Cookie — set true behind HTTPS in production
COOKIE_SECURE=false

# CORS origins (comma-separated, no trailing slash)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# First owner admin (used by seed:admin only — no public admin signup)
ADMIN_NAME=Owner Admin
ADMIN_EMAIL=owner@mushkfragrance.com
ADMIN_PASSWORD=ChangeMeStrongPass123!

# Cloudinary (optional until uploads are used)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional combined URL form (not required if the three vars above are set)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Mushk Fragrance <noreply@mushkfragrance.com>
